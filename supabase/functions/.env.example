# Edge Function secrets (server-side only – never put these in the frontend .env).
# Local: copy to supabase/functions/.env   Hosted: `npx supabase secrets set --env-file supabase/functions/.env`
ANTHROPIC_API_KEY=sk-ant-...
# Optional tuning (see supabase/functions/classify-questions/config.ts)
# SIMILARITY_THRESHOLD=0.65
# CLASSIFIER_MODEL=claude-opus-5
# CLASSIFIER_EFFORT=low
