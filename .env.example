# Used by `docker compose` and by the Go server (export these when running `go run .`).
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when running the server outside Docker:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/getit?sslmode=disable
# PORT=8080

# Optional tuning (see server/config.go)
# SIMILARITY_THRESHOLD=0.65
# CLASSIFIER_MODEL=claude-opus-5
# CLASSIFIER_EFFORT=low

# Frontend: only if the API lives on a different origin than the app
# VITE_API_URL=https://api.example.com
